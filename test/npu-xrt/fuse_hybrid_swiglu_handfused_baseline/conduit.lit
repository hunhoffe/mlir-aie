//
// Hand-fused single-device baseline for the SwiGLU-shaped 4-device fixture
// `test/npu-xrt/fuse_hybrid_swiglu_npu/`.  Same end-to-end compute, written
// already fused as one device with one core.  Goes through the STATEFUL
// aiecc pipeline (NO --use-conduit, NO --conduit-fuse-*-flag).
//
// Why this baseline exists: the auto-fused conduit version
// (fuse_hybrid_swiglu_npu) currently HW-FAILS with all-zero outputs.  This
// fixture compiles the same compute through the stateful path so we have a
// known-working post-AIEObjectFifoStatefulTransform IR shape for IR-diff
// against the broken auto-fused conduit IR — the diff isolates the bug
// surface introduced by the Conduit fusion passes.
//
// Compute reference (computed in test.cpp, identical to the auto-fused
// fixture):
//   gate_in[j] = up_in[j] = (j%8)
//   ext_out_a[j] = (gate*up) + 1.0
//   ext_out_b[j] = (gate*up) + 2.0
// All bf16-exact; max output 51 (well within bf16 integer range).
//
// REQUIRES: ryzen_ai, peano
//
// Kernel compute is inlined bf16 multiply + add.  Chess (xchesscc) cannot
// select `fp_to_bf16` for this inline core; Peano can.  Use
// `--no-xchesscc --no-xbridge` to route kernel compile through Peano
// (sibling pattern: fuse_hybrid_swiglu_npu/conduit.lit, fuse_channels_npu/
// conduit.lit, fuse_core_bodies_npu/conduit.lit, loadpdi/run.lit).
//
// Reference is independently authored by %S/gen_reference.py (numpy,
// derived from the spec text — closes "validation gap 2: independently-
// authored reference").  Two regimes run end-to-end:
//   symmetric  — gate[j] = up[j] = (j%8)              (legacy coverage)
//   asymmetric — gate[j] = (j%8), up[j] = (j%8)+1     (closes "validation
//                                                      gap 3: gate/up
//                                                      arg-mis-pairing
//                                                      blind spot")
// gen_reference.py is byte-identical to the one in fuse_hybrid_swiglu_npu/
// (same compute spec, intentional shared script, copied not symlinked
// for in-tree-portability).
//
// RUN: cp %S/aie.mlir aie_arch.mlir
// RUN: %run_on_npu2% sed 's/NPUDEVICE/npu2_4col/g' -i aie_arch.mlir
// RUN: %run_on_npu2% %python aiecc.py --no-aiesim --no-xchesscc --no-xbridge --aie-generate-xclbin --aie-generate-npu-insts --no-compile-host --xclbin-name=aie.xclbin --npu-insts-name=insts.bin aie_arch.mlir
// RUN: %run_on_npu2% clang %S/test.cpp -o test.exe -std=c++17 -Wall %xrt_flags -lrt -lstdc++ %test_utils_flags
// RUN: %run_on_npu2% %python %S/gen_reference.py --regime symmetric --out-dir .
// RUN: %run_on_npu2% ./test.exe -x aie.xclbin -k MLIR_AIE -i insts.bin --gate-in gate_in_sym.bin --up-in up_in_sym.bin --expected-a expected_a_sym.bin --expected-b expected_b_sym.bin
// RUN: %run_on_npu2% %python %S/gen_reference.py --regime asymmetric --out-dir .
// RUN: %run_on_npu2% ./test.exe -x aie.xclbin -k MLIR_AIE -i insts.bin --gate-in gate_in_asym.bin --up-in up_in_asym.bin --expected-a expected_a_asym.bin --expected-b expected_b_asym.bin
